# ============================================================================
# Environment Configuration for HireMind Interview Platform
# ============================================================================
# Copy this file to .env and fill in your actual API keys
# DO NOT commit actual .env file to version control (add to .gitignore)
# ============================================================================

# ============================================================================
# REQUIRED: LLM & TTS Configuration (Google Gemini - aistudio.google.com)
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
# Used for: Interview question generation, response evaluation, report generation, TTS synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# LLM model selection (options: "gemini-2.0-flash", "gemini-1.5-pro", "gemini-1.5-flash")
GEMINI_LLM_MODEL=gemini-2.0-flash

# TTS model and voice options
# Model: "gemini-2.0-flash-exp", "gemini-1.5-pro", etc.
# Voice: "Puck" (male), "Charon" (male deep), "Kore" (female), "Fenrir" (male serious), "Aoide" (female warm)
GEMINI_TTS_VOICE=Kore

# ============================================================================
# REQUIRED: Speech-to-Text Configuration (Deepgram)
# ============================================================================
# Get your API key from: https://console.deepgram.com
# Used for: Transcribing candidate audio responses
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Deepgram model (options: "nova-2", "nova-3", "nova-2-meeting")
DEEPGRAM_MODEL=nova-2

# ============================================================================
# Server Configuration
# ============================================================================
# Backend server port
BACKEND_PORT=8000

# Frontend dev server port
FRONTEND_PORT=5173

# Backend URL (used by frontend for API calls)
BACKEND_URL=http://localhost:8000

# Frontend URL (used by backend for CORS)
FRONTEND_URL=http://localhost:5173

# ============================================================================
# OPTIONAL: Redis Configuration (for session persistence)
# ============================================================================
# Redis connection string (optional, used for caching)
# Format: redis://[password]@[host]:[port]/[db]
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# OPTIONAL: Interview Configuration
# ============================================================================
# Maximum number of interview turns (questions asked to candidate)
MAX_INTERVIEW_TURNS=5

# Question timeout in seconds (how long to wait for audio response)
QUESTION_TIMEOUT=120

# Session timeout in minutes (how long session stays active)
SESSION_TIMEOUT=60

# ============================================================================
# OPTIONAL: Monitoring Configuration
# ============================================================================
# Enable enhanced integrity monitoring (requires additional GPU)
ENABLE_ADVANCED_MONITORING=true

# Video processing FPS (lower = faster but less accurate)
VIDEO_PROCESSING_FPS=10

# Audio processing sample rate (Hz)
AUDIO_SAMPLE_RATE=16000

# ============================================================================
# OPTIONAL: Development Configuration
# ============================================================================
# Enable debug mode (verbose logging, disable CORS restrictions)
DEBUG=false

# Enable mock responses (for testing without API keys)
MOCK_MODE=false

# ============================================================================
# NOTES:
# ============================================================================
# 1. All REQUIRED variables must be set before running the application
# 2. Missing API keys will cause startup errors or feature failures
# 3. Use docker-compose.override.yml for local Docker development
# 4. Never commit actual API keys to version control
# 5. Rotate API keys regularly for security
